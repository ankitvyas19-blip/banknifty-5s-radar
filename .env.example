# Server Port (Google Cloud Run injects PORT=8080 automatically)
PORT=8080

# Optional: Set persistent SQLite directory (e.g. Cloud Run mounted GCS/Filestore volume)
RADAR_DATA_DIR=./data

# DhanHQ v2 Credentials (can also be entered directly in the UI modal)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Set to 'true' to auto-connect DhanHQ WebSocket on server startup
DHAN_AUTO_CONNECT=false
